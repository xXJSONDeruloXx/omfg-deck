{
  "name": "omfg-deck",
  "version": "0.1.3",
  "description": "Decky Loader plugin for OMFG (Open Multi Frame Generation) Vulkan layer on Steam Deck",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "python3 -m pytest tests/ --cov=omfg --cov-report=term-missing -q"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xXJSONDeruloXx/omfg-deck.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "vulkan",
    "framegen",
    "omfg",
    "steam-deck"
  ],
  "author": "Kurt Himebauch",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xXJSONDeruloXx/omfg-deck/issues"
  },
  "homepage": "https://github.com/xXJSONDeruloXx/omfg-deck#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}